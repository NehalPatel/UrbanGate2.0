{
  "name": "urbangate",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --stream run dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @urbangate/database generate",
    "db:migrate": "pnpm --filter @urbangate/database migrate:dev",
    "db:push": "pnpm --filter @urbangate/database push",
    "db:seed": "pnpm --filter @urbangate/database seed",
    "db:reset": "pnpm db:push && pnpm db:seed",
    "mongo:rs": "powershell -ExecutionPolicy Bypass -File ./scripts/start-mongo-rs.ps1"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1"
  }
}

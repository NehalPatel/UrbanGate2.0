generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DISABLED
}

enum UnitRelationshipType {
  OWNER
  CO_OWNER
  TENANT
  RESIDENT
  FAMILY_MEMBER
}

enum BillingFrequency {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
  ONE_TIME
}

enum ChargeCalcMode {
  FIXED_PER_UNIT
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMode {
  CASH
  CHEQUE
  BANK_TRANSFER
  UPI
  MANUAL_ONLINE
}

enum PaymentStatus {
  RECORDED
  REVERSED
}

enum NoticeStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ComplaintStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
  REOPENED
}

enum ComplaintPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MeetingStatus {
  DRAFT
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum VisitorStatus {
  REQUESTED
  APPROVED
  CHECKED_IN
  CHECKED_OUT
  REJECTED
}

enum BookingStatus {
  REQUESTED
  CONFIRMED
  COMPLETED
  CANCELLED
}

model User {
  id              String     @id @default(auto()) @map("_id") @db.ObjectId
  email           String     @unique
  passwordHash    String
  name            String
  status          UserStatus @default(ACTIVE)
  isPlatformAdmin Boolean    @default(false)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  sessions          Session[]
  memberships       SocietyMembership[]
  unitRelationships UnitRelationship[]
  notifications     Notification[]
}

model Session {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  userId          String    @db.ObjectId
  user            User      @relation(fields: [userId], references: [id])
  tokenHash       String    @unique
  activeSocietyId String?   @db.ObjectId
  expiresAt       DateTime
  createdAt       DateTime  @default(now())
  revokedAt       DateTime?
}

model Society {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  slug      String   @unique
  timezone  String   @default("Asia/Kolkata")
  locale    String   @default("en-IN")
  currency  String   @default("INR")
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  buildings         Building[]
  memberships       SocietyMembership[]
  units             Unit[]
  maintenanceRules  MaintenanceRule[]
  billingRuns       BillingRun[]
  invoices          Invoice[]
  payments          Payment[]
  notices           Notice[]
  complaints        Complaint[]
  meetings          Meeting[]
  attachments       Attachment[]
  notifications     Notification[]
  gates             Gate[]
  visitors          Visitor[]
  emergencyContacts EmergencyContact[]
  vehicles          Vehicle[]
  amenities         Amenity[]
  amenityBookings   AmenityBooking[]
  householdMembers  HouseholdMember[]
  servicePersonnel  ServicePersonnel[]
  documents         SocietyDocument[]
}

model SocietyMembership {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  societyId String   @db.ObjectId
  society   Society  @relation(fields: [societyId], references: [id])
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  roleKeys  String[]
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([societyId, userId])
}

model Building {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  societyId String   @db.ObjectId
  society   Society  @relation(fields: [societyId], references: [id])
  name      String
  code      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  units Unit[]

  @@unique([societyId, name])
}

model Unit {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  societyId  String   @db.ObjectId
  society    Society  @relation(fields: [societyId], references: [id])
  buildingId String   @db.ObjectId
  building   Building @relation(fields: [buildingId], references: [id])
  number     String
  floor      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  relationships    UnitRelationship[]
  invoices         Invoice[]
  payments         Payment[]
  visitors         Visitor[]
  vehicles         Vehicle[]
  amenityBookings  AmenityBooking[]
  householdMembers HouseholdMember[]
  serviceLinks     ServicePersonnelUnit[]

  @@unique([societyId, buildingId, number])
}

model UnitRelationship {
  id        String               @id @default(auto()) @map("_id") @db.ObjectId
  societyId String               @db.ObjectId
  unitId    String               @db.ObjectId
  unit      Unit                 @relation(fields: [unitId], references: [id])
  userId    String               @db.ObjectId
  user      User                 @relation(fields: [userId], references: [id])
  type      UnitRelationshipType
  createdAt DateTime             @default(now())

  @@unique([unitId, userId, type])
}

model AuditLog {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  actorUserId   String?  @db.ObjectId
  societyId     String?  @db.ObjectId
  action        String
  entityType    String
  entityId      String?
  before        Json?
  after         Json?
  correlationId String?
  ip            String?
  userAgent     String?
  createdAt     DateTime @default(now())
}

model MaintenanceRule {
  id        String           @id @default(auto()) @map("_id") @db.ObjectId
  societyId String           @db.ObjectId
  society   Society          @relation(fields: [societyId], references: [id])
  name      String
  code      String?
  calcMode  ChargeCalcMode   @default(FIXED_PER_UNIT)
  /// Amount in paise (INR * 100). Prisma MongoDB has no Decimal.
  amount    Int
  frequency BillingFrequency @default(MONTHLY)
  active    Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  versions MaintenanceRuleVersion[]

  @@unique([societyId, name])
}

model MaintenanceRuleVersion {
  id            String         @id @default(auto()) @map("_id") @db.ObjectId
  societyId     String         @db.ObjectId
  ruleId        String         @db.ObjectId
  rule          MaintenanceRule @relation(fields: [ruleId], references: [id])
  amount        Int
  calcMode      ChargeCalcMode
  effectiveFrom DateTime
  createdAt     DateTime       @default(now())
}

model BillingRun {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  societyId       String   @db.ObjectId
  society         Society  @relation(fields: [societyId], references: [id])
  label           String
  periodStart     DateTime
  periodEnd       DateTime
  status          String   @default("COMPLETED")
  createdByUserId String   @db.ObjectId
  invoiceCount    Int      @default(0)
  createdAt       DateTime @default(now())

  invoices Invoice[]

  @@unique([societyId, label])
}

model Invoice {
  id                 String        @id @default(auto()) @map("_id") @db.ObjectId
  societyId          String        @db.ObjectId
  society            Society       @relation(fields: [societyId], references: [id])
  unitId             String        @db.ObjectId
  unit               Unit          @relation(fields: [unitId], references: [id])
  billingRunId       String        @db.ObjectId
  billingRun         BillingRun    @relation(fields: [billingRunId], references: [id])
  invoiceNumber      String
  status             InvoiceStatus @default(ISSUED)
  periodStart        DateTime
  periodEnd          DateTime
  issueDate          DateTime
  dueDate            DateTime
  currency           String        @default("INR")
  subtotal           Int
  total              Int
  paidAmount         Int       @default(0)
  outstandingAmount  Int
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  lines       InvoiceLine[]
  allocations PaymentAllocation[]

  @@unique([societyId, invoiceNumber])
  @@unique([billingRunId, unitId])
}

model InvoiceLine {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  societyId   String  @db.ObjectId
  invoiceId   String  @db.ObjectId
  invoice     Invoice @relation(fields: [invoiceId], references: [id])
  description String
  ruleId      String? @db.ObjectId
  amount      Int
  sortOrder   Int     @default(0)
}

model Payment {
  id                  String        @id @default(auto()) @map("_id") @db.ObjectId
  societyId           String        @db.ObjectId
  society             Society       @relation(fields: [societyId], references: [id])
  unitId              String?       @db.ObjectId
  unit                Unit?         @relation(fields: [unitId], references: [id])
  amount              Int
  mode                PaymentMode
  status              PaymentStatus @default(RECORDED)
  receiptNumber       String?
  reference           String?
  paidAt              DateTime
  recordedByUserId    String        @db.ObjectId
  notes               String?
  reversedAt          DateTime?
  reversalOfPaymentId String?       @db.ObjectId
  createdAt           DateTime      @default(now())

  allocations PaymentAllocation[]

  @@unique([societyId, receiptNumber])
}

model PaymentAllocation {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  societyId String  @db.ObjectId
  paymentId String  @db.ObjectId
  payment   Payment @relation(fields: [paymentId], references: [id])
  invoiceId String  @db.ObjectId
  invoice   Invoice @relation(fields: [invoiceId], references: [id])
  amount    Int
}

model Notice {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  societyId   String       @db.ObjectId
  society     Society      @relation(fields: [societyId], references: [id])
  title       String
  body        String
  status      NoticeStatus @default(DRAFT)
  audience    String       @default("SOCIETY")
  createdByUserId String   @db.ObjectId
  publishedAt DateTime?
  archivedAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Complaint {
  id              String            @id @default(auto()) @map("_id") @db.ObjectId
  societyId       String            @db.ObjectId
  society         Society           @relation(fields: [societyId], references: [id])
  unitId          String?           @db.ObjectId
  category        String
  subject         String
  description     String
  priority        ComplaintPriority @default(MEDIUM)
  status          ComplaintStatus   @default(OPEN)
  createdByUserId String            @db.ObjectId
  assignedToUserId String?          @db.ObjectId
  resolvedAt      DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model Meeting {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  societyId       String        @db.ObjectId
  society         Society       @relation(fields: [societyId], references: [id])
  title           String
  agenda          String
  description     String?
  scheduledAt     DateTime
  location        String?
  onlineLink      String?
  audience        String        @default("SOCIETY")
  status          MeetingStatus @default(DRAFT)
  minutes         String?
  createdByUserId String        @db.ObjectId
  completedAt     DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

/// Polymorphic file metadata; bytes live in object storage (ADR-007).
model Attachment {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  societyId        String   @db.ObjectId
  society          Society  @relation(fields: [societyId], references: [id])
  entityType       String
  entityId         String
  originalName     String
  storageKey       String
  mimeType         String
  sizeBytes        Int
  uploadedByUserId String   @db.ObjectId
  createdAt        DateTime @default(now())

  @@index([societyId, entityType, entityId])
}

model SocietyDocument {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  societyId       String   @db.ObjectId
  society         Society  @relation(fields: [societyId], references: [id])
  title           String
  category        String   @default("GENERAL")
  description     String?
  published       Boolean  @default(true)
  createdByUserId String   @db.ObjectId
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([societyId, published])
}

model Notification {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  societyId  String?   @db.ObjectId
  society    Society?  @relation(fields: [societyId], references: [id])
  userId     String    @db.ObjectId
  user       User      @relation(fields: [userId], references: [id])
  channel    String    @default("IN_APP")
  type       String
  title      String
  body       String
  entityType String?
  entityId   String?
  readAt     DateTime?
  emailedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, readAt])
  @@index([societyId, userId])
}

model Gate {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  societyId String   @db.ObjectId
  society   Society  @relation(fields: [societyId], references: [id])
  name      String
  code      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  visitors Visitor[]

  @@unique([societyId, name])
}

model Visitor {
  id                String        @id @default(auto()) @map("_id") @db.ObjectId
  societyId         String        @db.ObjectId
  society           Society       @relation(fields: [societyId], references: [id])
  category          String        @default("GUEST")
  name              String
  mobile            String
  purpose           String?
  vehicleNumber     String?
  unitId            String?       @db.ObjectId
  unit              Unit?         @relation(fields: [unitId], references: [id])
  gateId            String?       @db.ObjectId
  gate              Gate?         @relation(fields: [gateId], references: [id])
  status            VisitorStatus @default(REQUESTED)
  requestedByUserId String?       @db.ObjectId
  approvedByUserId  String?       @db.ObjectId
  checkedInByUserId String?       @db.ObjectId
  checkedOutByUserId String?      @db.ObjectId
  entryAt           DateTime?
  exitAt            DateTime?
  notes             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([societyId, status])
  @@index([societyId, mobile])
  @@index([societyId, vehicleNumber])
}

model EmergencyContact {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  societyId String   @db.ObjectId
  society   Society  @relation(fields: [societyId], references: [id])
  label     String
  phone     String
  category  String   @default("OTHER")
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([societyId, active])
}

model Vehicle {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  societyId          String   @db.ObjectId
  society            Society  @relation(fields: [societyId], references: [id])
  unitId             String?  @db.ObjectId
  unit               Unit?    @relation(fields: [unitId], references: [id])
  registrationNumber String
  type               String   @default("CAR")
  makeModel          String?
  ownerName          String?
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([societyId, registrationNumber])
}

model Amenity {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  societyId          String   @db.ObjectId
  society            Society  @relation(fields: [societyId], references: [id])
  name               String
  description        String?
  capacity           Int      @default(1)
  /// Fee in paise
  feePaise           Int      @default(0)
  /// Deposit in paise
  depositPaise       Int      @default(0)
  slotMinutes        Int      @default(60)
  advanceBookingDays Int      @default(14)
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  bookings AmenityBooking[]

  @@unique([societyId, name])
}

model AmenityBooking {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  societyId       String        @db.ObjectId
  society         Society       @relation(fields: [societyId], references: [id])
  amenityId       String        @db.ObjectId
  amenity         Amenity       @relation(fields: [amenityId], references: [id])
  unitId          String?       @db.ObjectId
  unit            Unit?         @relation(fields: [unitId], references: [id])
  bookedByUserId  String        @db.ObjectId
  startAt         DateTime
  endAt           DateTime
  status          BookingStatus @default(REQUESTED)
  feePaise        Int           @default(0)
  depositPaise    Int           @default(0)
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([societyId, amenityId, startAt])
  @@index([societyId, status])
}

model HouseholdMember {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  societyId String   @db.ObjectId
  society   Society  @relation(fields: [societyId], references: [id])
  unitId    String   @db.ObjectId
  unit      Unit     @relation(fields: [unitId], references: [id])
  name      String
  relation  String   @default("FAMILY")
  mobile    String?
  userId    String?  @db.ObjectId
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([societyId, unitId])
}

model ServicePersonnel {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  societyId          String   @db.ObjectId
  society            Society  @relation(fields: [societyId], references: [id])
  name               String
  mobile             String
  serviceType        String
  status             String   @default("ACTIVE")
  verificationStatus String   @default("UNVERIFIED")
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  units ServicePersonnelUnit[]

  @@index([societyId, serviceType])
  @@index([societyId, mobile])
}

model ServicePersonnelUnit {
  id          String           @id @default(auto()) @map("_id") @db.ObjectId
  societyId   String           @db.ObjectId
  personnelId String           @db.ObjectId
  personnel   ServicePersonnel @relation(fields: [personnelId], references: [id])
  unitId      String           @db.ObjectId
  unit        Unit             @relation(fields: [unitId], references: [id])
  createdAt   DateTime         @default(now())

  @@unique([personnelId, unitId])
}

model HealthCheck {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())
}

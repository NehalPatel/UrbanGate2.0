{
  "name": "@urbangate/database",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "pnpm generate && tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "generate": "prisma generate",
    "migrate:dev": "prisma db push",
    "push": "prisma db push",
    "seed": "tsx --env-file=../../.env prisma/seed.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint --config ../../eslint.config.mjs src --max-warnings=0",
    "test": "node --import tsx --test src/index.test.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "argon2": "^0.41.1",
    "dotenv": "^16.4.7",
    "prisma": "^6.5.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}

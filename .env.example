# Copy to .env and adjust for local development.
# Validated by @urbangate/config (see packages/config).

NODE_ENV=development

# API (admin-web / browsers)
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# MongoDB — Prisma requires a replica set for writes.
# Local: run `pnpm mongo:rs` then use the URL below (port 27018).
# Atlas: mongodb+srv://user:pass@cluster.mongodb.net/urbangate
DATABASE_URL=mongodb://127.0.0.1:27018/urbangate?replicaSet=rs0&directConnection=true

# Redis (optional until queues; matches docker-compose when used)
REDIS_URL=redis://localhost:6379

# API
API_PORT=3001
API_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:3003
LOG_LEVEL=info

# Auth (placeholders for MVP-0; used from MVP-1)
SESSION_SECRET=change-me-to-a-long-random-string-in-dev
COOKIE_SECURE=false

# Storage (local filesystem for development)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads

# Email (console in development)
EMAIL_DRIVER=console
